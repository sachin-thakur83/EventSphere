<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>EventSphere</display-name>
  <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>

  <!-- Secure session cookie. Add <secure>true</secure> when you serve over HTTPS. -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config><http-only>true</http-only></cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- No Java scriptlets allowed in JSPs: only EL + JSTL -->
  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <scripting-invalid>true</scripting-invalid>
    </jsp-property-group>
  </jsp-config>

  <!-- Friendly error pages (no stack traces shown to users) -->
  <error-page><error-code>403</error-code><location>/WEB-INF/views/common/error.jsp</location></error-page>
  <error-page><error-code>404</error-code><location>/WEB-INF/views/common/error.jsp</location></error-page>
  <error-page><error-code>500</error-code><location>/WEB-INF/views/common/error.jsp</location></error-page>
  <error-page><exception-type>java.lang.Throwable</exception-type><location>/WEB-INF/views/common/error.jsp</location></error-page>
</web-app>
